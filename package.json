{
  "name": "dsh-delegation-suite",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Ranked subagent delegation for DeepSeek Harness: role-based model routing with failover, per-route reasoning effort, fork delegation, transparent model labels, and a visual route editor in Settings.",
  "main": "lib/studio.host.js",
  "exports": {
    ".": "./lib/studio.host.js",
    "./package.json": "./package.json",
    "./delegation": "./lib/delegation.js",
    "./policy-hint": "./lib/policy-hint.js",
    "./studio": "./lib/studio.host.js",
    "./token-stats": "./lib/token-stats.host.js",
    "./client": "./lib/studio.client.js",
    "./typert": "./lib/typert.host.js"
  },
  "dsh": {
    "bundle": { "patch": "patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "lib",
    "tools",
    "patch.yml",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "delegation", "subagent", "routing", "models"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenheguo2/dsh-delegation-suite.git"
  },
  "homepage": "https://github.com/wenheguo2/dsh-delegation-suite#readme",
  "bugs": "https://github.com/wenheguo2/dsh-delegation-suite/issues",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "license": "MIT"
}
